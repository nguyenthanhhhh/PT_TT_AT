{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "yarn install"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "yarn start --max-old-space-size=8192",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}